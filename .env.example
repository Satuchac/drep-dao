# ---------------------------------------------------------------------------
# DRep DAO — environment template. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Database (Postgres 16) ---
# Matches infra/docker-compose.yml defaults for local dev.
DATABASE_URL="postgresql://drep:drep@localhost:5432/drepdao?schema=public"

# --- Redis (BullMQ job queue + session denylist) ---
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=4000
# JWT signing secret for wallet-auth sessions (§22.1). Generate: openssl rand -hex 32
JWT_SECRET="change-me-dev-only"
# Comma-separated origins allowed to call the API (the web app).
CORS_ORIGINS="http://localhost:3000"

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Cardano (§22) ---
# Build/test on Preprod, deploy MVP on mainnet (design §28.1 Q3).
CARDANO_NETWORK="Preprod"
# Blockfrost project id for the chosen network (primary read provider).
BLOCKFROST_PROJECT_ID=""
# Koios is the free fallback; base URL switches per network.
KOIOS_URL="https://preprod.koios.rest/api/v1"

# --- On-chain anchoring hot wallet (§23.4) — operational, NOT the multisig ---
# Bech32 secret key of the low-balance hot wallet that submits daily anchor TXs.
# Leave blank until anchoring is wired; keep OUT of git.
ANCHOR_HOT_WALLET_SKEY=""
ANCHOR_METADATA_LABEL=80808080

# --- Email (§21, Resend recommended for MVP) ---
RESEND_API_KEY=""
EMAIL_FROM="DRep DAO <no-reply@example.org>"
