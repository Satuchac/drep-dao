{
  "name": "drep-dao",
  "version": "0.0.0",
  "private": true,
  "description": "DRep DAO — Cardano governance platform (off-chain source of truth, on-chain anchoring)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @drep-dao/db generate",
    "db:migrate": "pnpm --filter @drep-dao/db migrate",
    "db:seed": "pnpm --filter @drep-dao/db seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  }
}
